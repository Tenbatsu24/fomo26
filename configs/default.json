{
  "model": {
    "variant": "3d",
    "size": "small",
    "lora": true,
    "task_tokens": false,
    "task_token_insertion": "middle",
    "task_token_block": 6
  },
  "pretrained": {
    "checkpoint": "small/neco/encoder_teacher.ckpt"
  },
  "data": {
    "dataset_name": "CLS002_FOMO26_Infarct",
    "crop_size": [224, 224, 32],
    "volume_patch_size": [14, 14, 2],
    "batch_size": 2,
    "num_workers": 1,
    "resample_spacing": null,
    "resize_to": [256, 256, 48]
  },
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 2e-3,
      "weight_decay": 0.05,
      "patch_embed_lr_mult": 0.2,
      "layerwise_decay": 0.9
    }
  },
  "trainer": {
    "accelerator": "auto",
    "accumulate_grad_batches": 1,
    "benchmark": false,
    "deterministic": false,
    "devices": "auto",
    "gradient_clip_algorithm": "norm",
    "gradient_clip_val": 3.0,
    "limit_val_batches": 1.0,
    "max_epochs": 25,
    "num_nodes": 1,
    "num_sanity_val_steps": 0,
    "precision": "32-true",
    "strategy": "auto",
    "sync_batchnorm": false,
    "check_val_every_n_epoch": 5
  },
  "scheduler": [
    [
      "lr",
      "CatSched(LinSched(2e-5, 2e-3), CosSched(2e-3, 2e-6), 5)"
    ],
    [
      "weight_decay",
      "CosSched(0.04, 0.4)"
    ]
  ],
  "loss": null,
  "metrics": null,
  "test": {
    "batch_size": 1,
    "amp": false
  },
  "seed": 42
}
