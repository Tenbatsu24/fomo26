{
  "model": {
    "variant": "3d",
    "size": "small",
    "lora": true,
    "query_from": -6
  },
  "pretrained": {
    "checkpoint": "small/neco/encoder_teacher.ckpt"
  },
  "data": {
    "dataset_name": "CLS002_FOMO26_Infarct",
    "crop_size": [
      224,
      224,
      32
    ],
    "volume_patch_size": [
      14,
      14,
      8
    ],
    "batch_size": 2,
    "num_workers": 2,
    "resample_spacing": "median",
    "resize_to": [
      284,
      284,
      48
    ]
  },
  "enable_aug": true,
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 0.002,
      "weight_decay": 0.05,
      "patch_embed_lr_mult": 0.2,
      "layerwise_decay": 0.9
    }
  },
  "trainer": {
    "accelerator": "auto",
    "accumulate_grad_batches": 1,
    "benchmark": false,
    "deterministic": false,
    "devices": "auto",
    "gradient_clip_algorithm": "norm",
    "gradient_clip_val": 3.0,
    "limit_val_batches": 1.0,
    "max_epochs": 10,
    "num_nodes": 1,
    "num_sanity_val_steps": 0,
    "precision": "32-true",
    "strategy": "auto",
    "sync_batchnorm": false,
    "check_val_every_n_epoch": 1
  },
  "scheduler": [
    [
      "lr",
      "CatSched(LinSched(2e-8, 2e-5), CosSched(2e-5, 0.0), 0.05)"
    ],
    [
      "weight_decay",
      "CosSched(0.04, 0.05)"
    ]
  ],
  "loss": null,
  "metrics": null,
  "test": {
    "batch_size": 1,
    "amp": false
  },
  "seed": 42
}
