{
  "model": {
    "variant": "2d",
    "size": "small",
    "lora": false
  },
  "pretrained": {
    "checkpoint": "small/neco/encoder_teacher.ckpt"
  },
  "data": {
    "dataset_name": "SEG010_FOMO26_TrigeminalNeuralgia",
    "crop_size": [518, 518, -1],
    "batch_size": 1,
    "num_workers": 2
  },
  "enable_aug": true,
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 0.002,
      "weight_decay": 0.05,
      "patch_embed_lr_mult": 0.2,
      "layerwise_decay": 0.9
    }
  },
  "trainer": {
    "accelerator": "auto",
    "accumulate_grad_batches": 8,
    "benchmark": false,
    "deterministic": false,
    "devices": "auto",
    "gradient_clip_val": 0.5,
    "max_steps": 100,
    "num_nodes": 1,
    "num_sanity_val_steps": 0,
    "precision": "bf16-mixed",
    "strategy": "auto",
    "sync_batchnorm": false,
    "val_check_interval": 80,
    "check_val_every_n_epoch": null,
    "log_every_n_steps": 1
  },
  "scheduler": [
    [
      "lr",
      "CatSched(LinSched(1e-8, 2e-3), CosSched(2e-3, 1e-9), 0.25)"
    ],
    [
      "weight_decay",
      "ConstSched(0.05)"
    ]
  ],
  "loss": null,
  "metrics": null,
  "seed": 42,
  "test": {
    "sliding_window": false
  }
}
